{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with tests enabled.",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CODA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build without tests.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CODA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "afl",
      "displayName": "AFL++",
      "description": "AFL++ LLVM-mode instrumented formatter fuzz target.",
      "binaryDir": "${sourceDir}/build/afl",
      "environment": {
        "AFL_CC_COMPILER": "LLVM"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "afl-c++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CODA_BUILD_TESTS": "OFF",
        "CODA_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "afl-asan",
      "inherits": "afl",
      "displayName": "AFL++ with ASAN",
      "description": "AFL++ formatter fuzz target with AddressSanitizer instrumentation.",
      "binaryDir": "${sourceDir}/build/afl-asan",
      "environment": {
        "AFL_USE_ASAN": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "afl",
      "configurePreset": "afl"
    },
    {
      "name": "afl-asan",
      "configurePreset": "afl-asan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
